{
  "manifest_version": 3,
  "name": "FragEngine Telemetry Link",
  "version": "0.16.2",
  "description": "Real-time telemetry extraction, Cyber-Red HUD overlay, and Broadcast Studio Command Center for FragLab Analytics.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": [
        "roundabout_dock.css"
      ],
      "js": [
        "feed_detector.js",
        "transmission_scheduler.js",
        "sampling_engine.js",
        "overlay_injector.js",
        "roundabout_dock.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["studio.html", "dashboard.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {},
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-ingest": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle Frame Sampling Ingest"
    },
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Toggle In-Page Cyber-Red Overlay"
    },
    "toggle-roundabout": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle Smart Roundabout App Dock"
    }
  }
}
